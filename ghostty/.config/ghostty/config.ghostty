# Ghostty (stow package `ghostty`). Portable: macos-* keys are ignored on Linux.
# Reload: Cmd+Shift+,   List options: ghostty +show-config --default --docs

# Look
theme = Night Owl
font-size = 14
font-thicken = true
cursor-style = bar
cursor-style-blink = false
adjust-cell-height = 10%

# Window
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
background-opacity = 0.95
background-blur = 20
window-save-state = always
macos-titlebar-style = tabs

# Input
# Option works as Alt: needed for fzf Alt-C, word jumps
macos-option-as-alt = true
mouse-hide-while-typing = true
copy-on-select = clipboard
shell-integration-features = cursor,sudo,title

# Quick (dropdown) terminal from anywhere: Cmd+`
# First use: allow Ghostty under System Settings > Privacy & Security > Accessibility
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-animation-duration = 0.15
quick-terminal-autohide = true

# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+shift+enter=toggle_split_zoom
