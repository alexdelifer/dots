#!/usr/bin/env bash
# hypr-display: laptop + external monitor modes for Hyprland 0.57 (Lua).
#   hypr-display            rofi menu (bound to SUPER+P)
#   hypr-display extend     external to the right of the laptop panel (default on hotplug)
#   hypr-display mirror     external mirrors the laptop panel
#   hypr-display external   external only, laptop panel off (lid-closed style)
#   hypr-display laptop     laptop panel only, external off
# A config reload (or re-login) goes back to the host file's layout = extend.
set -euo pipefail
INTERNAL=${HYPR_INTERNAL:-eDP-1}

mon(){ hyprctl eval "hl.monitor({ $1 })" >/dev/null; }
notify(){ command -v notify-send >/dev/null && notify-send -a hypr-display "Display" "$1" || true; }

# connected outputs other than the panel (includes currently disabled ones)
mapfile -t EXT < <(hyprctl -j monitors all | jq -r --arg i "$INTERNAL" '.[] | select(.name != $i) | .name')

mode=${1:-}
if [[ -z $mode ]]; then
    mode=$(printf '%s\n' "extend" "mirror" "external" "laptop" \
        | rofi -dmenu -i -p "display" -mesg "external: ${EXT[*]:-none}") || exit 0
fi

if (( ${#EXT[@]} == 0 )) && [[ $mode != laptop ]]; then
    notify "No external monitor connected"; mon "output = \"$INTERNAL\", mode = \"preferred\", position = \"0x0\", scale = 1"; exit 0
fi

case $mode in
extend)
    mon "output = \"$INTERNAL\", mode = \"preferred\", position = \"0x0\", scale = 1"
    for e in "${EXT[@]}"; do mon "output = \"$e\", mode = \"preferred\", position = \"auto-right\", scale = 1"; done ;;
mirror)
    mon "output = \"$INTERNAL\", mode = \"preferred\", position = \"0x0\", scale = 1"
    for e in "${EXT[@]}"; do mon "output = \"$e\", mode = \"preferred\", position = \"auto\", scale = 1, mirror = \"$INTERNAL\""; done ;;
external)
    for e in "${EXT[@]}"; do mon "output = \"$e\", mode = \"preferred\", position = \"0x0\", scale = 1"; done
    mon "output = \"$INTERNAL\", disabled = true" ;;
laptop)
    mon "output = \"$INTERNAL\", mode = \"preferred\", position = \"0x0\", scale = 1"
    for e in "${EXT[@]}"; do mon "output = \"$e\", disabled = true"; done ;;
*) echo "usage: hypr-display [extend|mirror|external|laptop]" >&2; exit 1 ;;
esac
notify "$mode"
